<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteBase /

    # 1. 301 Redirect nếu truy cập trực tiếp có tiền tố /public/
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s+/public/([^\s?]*) [NC]
    RewriteRule ^ /%1 [L,NE,R=301]

    # 2. Bỏ qua nếu đường dẫn đã có sẵn chữ /public/ để tránh loop
    RewriteCond %{REQUEST_URI} !^/public/
    
    # 3. Chuyển tiếp ngầm toàn bộ vào thư mục public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Cấu hình PHP Limits
php_value max_execution_time 120
php_value memory_limit 256M
php_value upload_max_filesize 50M
php_value post_max_size 50M