{
    "architecture": "DATABASE_PER_PROJECT",
    "version": "1.0.0",
    "central_database": {
        "database_name": "core",
        "purpose": "Multi-Project Registry, Domain Mapping, Agency CRM, DevOps Deployments, Platform RBAC",
        "table_count": 28,
        "tables": [
            "activity_logs",
            "agents",
            "briefs",
            "contracts",
            "customers",
            "departments",
            "deployment_history",
            "deployment_logs",
            "feature_packs",
            "hosting_profiles",
            "permissions",
            "project_members",
            "project_permissions",
            "project_settings",
            "project_stages",
            "project_ticket_replies",
            "project_tickets",
            "projects",
            "role_permissions",
            "roles",
            "service_stages",
            "services",
            "system_backups",
            "system_logs",
            "tasks",
            "tenants",
            "user_permissions",
            "user_roles"
        ]
    },
    "system_database": {
        "purpose": "Laravel Framework Core Queues, Cache, and Sessions",
        "table_count": 7,
        "tables": [
            "cache",
            "cache_locks",
            "failed_jobs",
            "job_batches",
            "jobs",
            "migrations",
            "sessions"
        ]
    },
    "standard_project_database": {
        "purpose": "Isolated Tenant Business Data per Website\/Application",
        "table_count": 48,
        "tables": [
            "attribute_groups",
            "brand_product",
            "brands",
            "coupons",
            "ehenho_conversations",
            "ehenho_messages",
            "ehenho_profiles",
            "ehenho_provinces",
            "ehenho_social_connections",
            "flash_sale_campaigns",
            "flash_sale_items",
            "form_submissions",
            "form_templates",
            "languages",
            "menu_items",
            "menus",
            "modal_forms",
            "order_items",
            "order_status_histories",
            "orders",
            "page_sections",
            "posts",
            "product_attribute_product",
            "product_attribute_value_mappings",
            "product_attribute_values",
            "product_attributes",
            "product_categories",
            "product_category_product",
            "product_combos",
            "product_reviews",
            "product_variations",
            "products_enhanced",
            "reviews",
            "settings",
            "shipping_carriers",
            "shipping_rate_versions",
            "shipping_rule_conditions",
            "shipping_rules",
            "shipping_zone_locations",
            "shipping_zones",
            "taxonomies",
            "term_relationships",
            "translations",
            "user_addresses",
            "users",
            "visitor_logs",
            "widget_templates",
            "widgets"
        ],
        "modules": {
            "Authentication": [
                "users",
                "user_addresses"
            ],
            "Dating_And_Social": [
                "profiles",
                "provinces",
                "conversations",
                "messages",
                "social_connections"
            ],
            "Catalog_Ecommerce": [
                "products",
                "product_categories",
                "product_category_product",
                "brands",
                "brand_product",
                "product_attributes",
                "product_attribute_values",
                "product_attribute_value_mappings",
                "product_attribute_product",
                "attribute_groups",
                "product_combos",
                "product_variations",
                "orders",
                "order_items",
                "order_status_histories",
                "coupons",
                "flash_sale_campaigns",
                "flash_sale_items",
                "shipping_zones",
                "shipping_zone_locations",
                "shipping_carriers",
                "shipping_rules",
                "shipping_rule_conditions",
                "shipping_rate_versions",
                "product_reviews",
                "reviews"
            ],
            "CMS_Content": [
                "posts",
                "page_sections",
                "menus",
                "menu_items",
                "widgets",
                "widget_templates",
                "taxonomies",
                "term_relationships",
                "translations",
                "languages"
            ],
            "Forms_And_Leads": [
                "form_submissions",
                "form_templates",
                "modal_forms"
            ],
            "Settings_And_Analytics": [
                "settings",
                "visitor_logs"
            ]
        }
    },
    "theme_prefix_standardization": {
        "strategy": "STANDARDIZE_WHEN_ISOLATED",
        "mappings": {
            "ehenho_profiles": "profiles",
            "ehenho_provinces": "provinces",
            "ehenho_conversations": "conversations",
            "ehenho_messages": "messages",
            "ehenho_social_connections": "social_connections"
        },
        "rationale": "When each project has its own isolated database, table prefixes like ehenho_ are no longer necessary. Standard tables allow any theme or application to reuse identical migrations and standard project models."
    }
}