        <style>
            .widget_check_domain {
                background-size: 100%!important;
                background-attachment: inherit!important;
                background-position: bottom!important;
                background-color: #efefef!important;
            }
            .check-domain-title span {
                display: block;
                font-size: 14px;
                text-transform: capitalize;
                font-weight: 500;
                letter-spacing: 0;
                margin-bottom: 10px;
                color: #aebfc7;
            }
            .check-domain-title small {
                display: block;
                font-size: 14px;
                text-transform: capitalize;
                font-weight: 500;
                letter-spacing: 0;
                margin-bottom: 10px;
                color: #aebfc7;
            }
            .check-domain-title h3 {
                text-transform: uppercase;
                font-weight: bold;
                font-size: 35px;
                letter-spacing: 1px;
                margin-bottom: 10px;
                color: #ff0000;
                position: relative;
            }
            #domain-search-header {
                padding-left: 0;
                position: relative;
                margin-bottom: 20px;
            }
            #domain-search-header .fa-globe {
                position: absolute;
                top: 19px;
                left: 22px;
                font-size: 23px;
                color: #dcdee0;
            }
            #domain-search-header input {
                width: 100%;
                border: 0;
                height: 60px;
                border-radius: 25px;
                outline: none;
                padding-left: 60px;
                line-height: 61px;
                box-shadow: 12px 12px 30px 0 rgba(77,77,119,.10);
                font-weight: 500;
                color: #8ba2ad;
            }
            #domain-search-header .inline-button-domain-order {
                position: absolute;
                top: 10px;
                right: 25px;
            }
            #domain-search-header .inline-button-domain-order #search-btn {
                background-image: linear-gradient(to right,#ff8585,#ff3d3d);
                border: 0;
                transition: background-size .2s ease-in-out,.2s box-shadow ease-in-out,.2s filter,.3s opacity;
                color: #fff;
                height: 40px;
                width: 40px;
                font-size: 14px;
                border-radius: 50px;
                outline: none !important;
                line-height: 40px;
                cursor: pointer;
                box-shadow: 3px 4px 31px 0 rgba(253, 165, 93, 0.54);
                margin-left: 2px;
                -webkit-transition: all 0.2s ease-in-out;
                -moz-transition: all 0.2s ease-in-out;
                -o-transition: all 0.2s ease-in-out;
                -ms-transition: all 0.2s ease-in-out;
                transition: all 0.2s ease-in-out;
            }
            #domain-search-header .inline-button-domain-order #transfer-btn {
                background-image: linear-gradient(to right,#5c5cfd,#d65ffd);
                border: 0;
                transition: background-size .2s ease-in-out,.2s box-shadow ease-in-out,.2s filter,.3s opacity;
                color: #fff;
                height: 40px;
                width: 40px;
                font-size: 14px;
                border-radius: 50px;
                outline: none !important;
                line-height: 40px;
                cursor: pointer;
                box-shadow: 3px 4px 31px 0 rgba(149, 94, 253, 0.45);
                -webkit-transition: all 0.2s ease-in-out;
                -moz-transition: all 0.2s ease-in-out;
                -o-transition: all 0.2s ease-in-out;
                -ms-transition: all 0.2s ease-in-out;
                transition: all 0.2s ease-in-out;
            }

            .domain-extensions-list {
                overflow: hidden;
            }
            .domain-extensions-list .domain-extensions-item {
                overflow: hidden;
            }
            .domain-extensions-list .domain-extensions-item .domain-extensions-content {
                height: 120px;
                position: relative;
                padding: 20px 10px;
                background: #fff;
                border-radius: 10px;
                box-shadow: 0 2px 20px rgba(0,0,0,.05);
                overflow: hidden;
                font-size: 16px;
                color: #1c4a71;
                animation: fadeIn .4s ease-in;
            }
            .domain-extensions-list .domain-extensions-item .domain-extensions-content .domain-extensions-ribbon {
                position: absolute;
                width: 70px;
                height: 70px;
                background: #e94d4d;
                top: -34px;
                right: -34px;
                border-radius: 30px;
                transition: all linear .25s;
            }
            .domain-extensions-list .domain-extensions-item .domain-extensions-content .domain-extensions-ribbon i:before {
                font-size: 16px;
                color: gold;
                position: absolute;
                bottom: 12px;
                left: 12px;
            }
            .domain-extensions-list .domain-extensions-item .domain-extensions-content .domain-extensions-content-left {
                float: left;
                padding: 10px 0;
                text-align: center;
                width: 100%;
                animation: fadeIn .4s ease-in;
                transition: all linear .25s;
            }
            .domain-extensions-list .domain-extensions-item .domain-extensions-content strong {
                font-size: 22px;
                line-height: 28px;
                font-weight: 700;
                display: block;
            }
            .domain-extensions-list .domain-extensions-item .domain-extensions-content .domain-extensions-content-left span {
                color:#000;
            }
            .domain-extensions-list .domain-extensions-item .domain-extensions-content .domain-extensions-content-right {
                height: 100%;
                text-align: right;
                padding-right: 10px;
                width: 100%;
                display: none;
                font-size: 13px;
                font-weight: 500;
                position: relative;
            }
            .domain-extensions-list .domain-extensions-item .domain-extensions-content .price-old {
                text-decoration: line-through;
            }
            .domain-extensions-list .domain-extensions-item:hover .domain-extensions-content {
                padding-top:10px;
            }
            .domain-extensions-list .domain-extensions-item:hover .domain-extensions-content .domain-extensions-content-left {
                padding: 0;
            }
            .domain-extensions-list .domain-extensions-item:hover .domain-extensions-content .domain-extensions-content-right {
                animation: fadeIn .4s ease-in;
                display: inline-block;
                padding: 0;
                text-align: center;
            }
        </style>
