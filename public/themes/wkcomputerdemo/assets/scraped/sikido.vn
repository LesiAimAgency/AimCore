b.archive.org/web/20250119091227js_/https://sikido.vn/views/theme-store/assets/add-on/fancybox-3/jquery.fancybox.min.js" charset="utf-8"></script><script type="text/javascript" src="https://web.archive.org/web/20250119091227js_/https://sikido.vn/views/theme-store/assets/add-on/lazyload/lazyload.min.js" charset="utf-8"></script><script type="text/javascript" src="https://web.archive.org/web/20250119091227js_/https://sikido.vn/views/theme-store/assets/add-on/flexible/jquery.easy-ticker.js" charset="utf-8"></script><script type="text/javascript" src="/web/20250119091227js_/https://sikido.vn/scripts/ToastMessages/jquery.toast.js" charset="utf-8"></script><script type="text/javascript" src="/web/20250119091227js_/https://sikido.vn/views/plugins/couponwheel/assets/couponwheel.js" charset="utf-8"></script><script type="text/javascript" src="/web/20250119091227js_/https://sikido.vn/views/plugins/couponwheel/assets/dialog_trigger.js" charset="utf-8"></script>	<script type="text/javascript">
		$(function(){
            AOS.init();
            var aos_in = false;
            $(window).scroll(function () {
                if(aos_in == false) {
                    AOS.init();
                    aos_in = true;
                }
            });
					});

		$(document).ready(function(){
	
			$('.dangkylich').click(function(){
				console.log(base);
				var name = $('input[name=name_cus]').val();
				var phone = $('input[name=phone_cus]').val();
				var email = $('input[name=email_cus]').val();
				// var location = $('textarea[name=location_cus]').val();
				// Checking
				if (name == '' || phone == ''  || email == '') {
					alert("Oops, bạn nhập thiếu thông tin rồi!");
				} else {
					alert("Cảm ơn bạn đã liên hệ với chúng tôi!");
					data = {
						'action' 		: 'ajax_dangkynhantin',
						'name'			: name,
						'phone'			: phone,
						'email'			: email
						
					}

					$jqxhr   = $.post(base+'/ajax', data, function(data) {}, 'json');

					$jqxhr.done(function( data ) {});
					// $("#dangky")[0].reset();
					$('#message').val('');
				};
				return false;
			});

			$('.js_trgop_btn_buy').click(function () {

			    $('.loading').show();

                let data = {
                    'action': 'tragop_ajax_add_cart',
                    'id'    : $(this).attr('data-id'),
                };

                console.log(data);

                $jqxhr = $.post(base+'/ajax', data, function () { }, 'json');

                $jqxhr.done(function (response) {

                    show_message(response.message, response.status);

                    if (response.status === 'success') {
                        window.location = 'thanh-toan-tra-gop';
                    }
                    else {
                        $('.loading').hide();
                    }
                });

                $jqxhr.fail(function (data) {});

                $jqxhr.always(function (data) { });

                return false;
            });
		});
	</script>
